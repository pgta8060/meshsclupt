// Resources for SculptMesh.dlo
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Modify-panel rollout

// Empty page: the rows are drawn by a child window sized to its content.
IDD_ROWS_ROLLUP DIALOGEX 0, 0, 108, 20
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
// Default keyboard shortcuts (action table "Sculpt Mesh")

IDR_SCULPT_SHORTCUTS ACCELERATORS
BEGIN
    "1",            ID_SCULPT_SLOT1,            VIRTKEY, NOINVERT
    "2",            ID_SCULPT_SLOT2,            VIRTKEY, NOINVERT
    "3",            ID_SCULPT_SLOT3,            VIRTKEY, NOINVERT
    "4",            ID_SCULPT_SLOT4,            VIRTKEY, NOINVERT
    "5",            ID_SCULPT_SLOT5,            VIRTKEY, NOINVERT
    VK_SPACE,       ID_SCULPT_QUICK_MENU,       VIRTKEY, NOINVERT
    "W",            ID_SCULPT_MOVE,             VIRTKEY, NOINVERT
    "E",            ID_SCULPT_ROTATE,           VIRTKEY, NOINVERT
    "R",            ID_SCULPT_SCALE,            VIRTKEY, NOINVERT
    "W",            ID_SCULPT_GROUP_FROM_MASK,  VIRTKEY, CONTROL, NOINVERT
    VK_ESCAPE,      ID_SCULPT_CANCEL,           VIRTKEY, NOINVERT
    "S",            ID_SCULPT_STENCIL,          VIRTKEY, NOINVERT
END

