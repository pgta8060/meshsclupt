            VALUE "FileDescription", "Sculpt Mesh plugin for 3ds Max"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "SculptMesh"
            VALUE "OriginalFilename", "SculptMesh.dlo"
            VALUE "ProductName", "Sculpt Mesh"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
