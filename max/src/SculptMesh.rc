// Resources for SculptMesh.dlo
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Modify-panel rollout (phase 1)

IDD_SCULPT_PANEL DIALOGEX 0, 0, 108, 186
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    CONTROL         "Sculpt", IDC_SCULPT_BUTTON, "CustButton", WS_TABSTOP, 4, 4, 100, 16
    LTEXT           "Brush:", IDC_STATIC, 4, 27, 24, 8
    COMBOBOX        IDC_BRUSH_COMBO, 32, 25, 72, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Add", IDC_ADD_RADIO, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 16, 42, 34, 10
    CONTROL         "Sub", IDC_SUB_RADIO, "Button", BS_AUTORADIOBUTTON, 60, 42, 34, 10
    RTEXT           "Size (px):", IDC_STATIC, 4, 59, 44, 8
    CONTROL         "", IDC_SIZE_EDIT, "CustEdit", WS_TABSTOP, 50, 58, 42, 10
    CONTROL         "", IDC_SIZE_SPIN, "SpinnerControl", 0x0, 93, 58, 7, 10
    RTEXT           "Strength:", IDC_STATIC, 4, 73, 44, 8
    CONTROL         "", IDC_STRENGTH_EDIT, "CustEdit", WS_TABSTOP, 50, 72, 42, 10
    CONTROL         "", IDC_STRENGTH_SPIN, "SpinnerControl", 0x0, 93, 72, 7, 10
    RTEXT           "Spacing:", IDC_STATIC, 4, 87, 44, 8
    CONTROL         "", IDC_SPACING_EDIT, "CustEdit", WS_TABSTOP, 50, 86, 42, 10
    CONTROL         "", IDC_SPACING_SPIN, "SpinnerControl", 0x0, 93, 86, 7, 10
    CONTROL         "Use Falloff", IDC_FALLOFF_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 102, 90, 10
    CONTROL         "Backface Cull", IDC_BACKFACE_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 114, 90, 10
    LTEXT           "", IDC_INFO_TEXT, 6, 131, 98, 8
    LTEXT           "", IDC_HELP_TEXT, 6, 145, 98, 34
END

/////////////////////////////////////////////////////////////////////////////
// Strings

STRINGTABLE
BEGIN
    IDS_LIB_DESCRIPTION     "Sculpt Mesh - sculpting tools for 3ds Max"
    IDS_CLASS_NAME          "Sculpt Mesh"
    IDS_CATEGORY            "Sculpt Mesh"
    IDS_OBJECT_NAME         "Sculpt Mesh"
    IDS_ROLLUP_TITLE        "Sculpt Mesh"
    IDS_UNDO_STROKE         "Sculpt Stroke"
    IDS_UNDO_CONVERT        "Convert to Sculpt Mesh"
    IDS_PROMPT_SCULPT       "Sculpt Mesh: drag to sculpt | Shift: Smooth | Alt: invert | Right-click: exit"
    IDS_ERR_SELECT_ONE      "Sculpt Mesh: select a single Sculpt Mesh object to sculpt."
    IDS_ERR_CANNOT_CONVERT  "This object cannot be converted to a Sculpt Mesh."
    IDS_BRUSH_SCULPT        "Sculpt"
    IDS_BRUSH_SMOOTH        "Smooth"
    IDS_BRUSH_INFLATE       "Inflate"
    IDS_BRUSH_PINCH         "Pinch"
    IDS_INFO_FORMAT         "Vertices: %d   Polygons: %d"
    IDS_FP_DESCRIPTION      "Sculpt Mesh tools"
END

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Sculpt Mesh plugin for 3ds Max"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "SculptMesh"
            VALUE "OriginalFilename", "SculptMesh.dlo"
            VALUE "ProductName", "Sculpt Mesh"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
